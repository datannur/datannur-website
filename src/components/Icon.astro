---
// Font Awesome 6 Free icons inlined as SVG (no webfont loaded).
// The .svg files come from @fortawesome/fontawesome-free (CC BY 4.0 license).
interface Props {
  name: string
  class?: string
}
const { name, class: className } = Astro.props

const icons = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})
const raw = icons[`../icons/${name}.svg`]
if (!raw) throw new Error(`Unknown icon: ${name}`)

// strip the license comment and inject class + fill;
// icon-c-<name> allows per-icon coloring where the CSS enables it (menu, titles)
const svg = raw
  .replace(/<!--.*?-->/s, '')
  .replace(
    '<svg ',
    `<svg class="icon icon-c-${name}${className ? ` ${className}` : ''}" fill="currentColor" aria-hidden="true" `
  )
---

<Fragment set:html={svg} />

---
// Icônes Font Awesome 6 Free inlinées en SVG (aucune webfont chargée).
// Les fichiers .svg viennent de @fortawesome/fontawesome-free (licence CC BY 4.0).
interface Props {
  name: string
  class?: string
}
const { name, class: className } = Astro.props

const icons = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})
const raw = icons[`../icons/${name}.svg`]
if (!raw) throw new Error(`Icône inconnue : ${name}`)

// on retire le commentaire de licence et on injecte class + fill
const svg = raw
  .replace(/<!--.*?-->/s, '')
  .replace(
    '<svg ',
    `<svg class="icon${className ? ` ${className}` : ''}" fill="currentColor" aria-hidden="true" `
  )
---

<Fragment set:html={svg} />

# datannur.com — static site (Astro)

# force https
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# custom 404 page
ErrorDocument 404 /404.html

# useful mime types
AddType image/webp .webp
AddType image/avif .avif

# compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# cache: long for fingerprinted assets and images, short for HTML
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|png|jpe?g|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
